{
  "name": "superpowers-app",
  "productName": "Superpowers",
  "version": "6.1.0",
  "description": "Desktop app for Superpowers, the HTML5 2D+3D game maker",
  "author": "Sparklin Labs",
  "license": "ISC",
  "private": true,
  "main": "out/main/index.js",
  "superpowers": {
    "appApiVersion": 5
  },
  "scripts": {
    "dev": "electron-vite dev -- --core-path=.dev-core",
    "build": "electron-vite build",
    "start": "electron-vite preview -- --core-path=.dev-core",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && svelte-check --tsconfig ./tsconfig.web.json --fail-on-warnings",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "irc-framework": "^4.14.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^24.0.0",
    "@types/yauzl": "^3.4.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild": true,
    "electron-winstaller": false,
    "fsevents": false,
    "core-js": false
  }
}
