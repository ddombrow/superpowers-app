{
  "name": "superpowers-app",
  "productName": "Superpowers",
  "version": "6.1.0",
  "description": "Desktop app for Superpowers, the HTML5 2D+3D game maker",
  "author": "Sparklin Labs",
  "license": "ISC",
  "private": true,
  "main": "out/main/index.js",
  "superpowers": {
    "appApiVersion": 5
  },
  "scripts": {
    "dev": "npm run build:legacy && electron-vite dev -- --core-path=.dev-core",
    "build": "electron-vite build && npm run build:legacy",
    "build:legacy": "node scripts/build-legacy-renderer.mjs",
    "start": "electron-vite preview -- --core-path=.dev-core",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.legacy.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "irc-framework": "^4.14.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.63.0",
    "@types/async": "^2.4.1",
    "@types/escape-html": "0.0.20",
    "@types/node": "^24.0.0",
    "@types/yauzl": "^3.4.0",
    "async": "^2.6.2",
    "dnd-tree-view": "^4.0.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "escape-html": "^1.0.3",
    "eslint": "^10.11.0",
    "events": "^3.3.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "pug": "^3.0.3",
    "resize-handle": "^5.0.0",
    "simple-dialogs": "^2.0.0",
    "stylus": "^0.64.0",
    "tab-strip": "^2.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild": true,
    "electron-winstaller": false,
    "fsevents": false,
    "core-js": false
  }
}
